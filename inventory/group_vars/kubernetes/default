---
# Upstream releases checked on 2026-10-31; override in a private vars file.
k8s_version: "1.37.2"
k8s_repo_version: "{{ k8s_version.split('.')[:2] | join('.') }}"
crio_version: "1.37.2"
containerd_version: "2.4.2"
calico_version: "v3.33.0"
# Opt in on a new cluster with different private NIC names across nodes.
calico_use_node_internal_ip: false
flannel_version: "v0.28.10"
k8s_runtime_environment: crio
k8s_cri_socket: "{{ 'unix:///var/run/crio/crio.sock' if k8s_runtime_environment == 'crio' else 'unix:///run/containerd/containerd.sock' }}"
k8s_repo_image_addr: registry.k8s.io
k8s_proxy_mode_enable: true
k8s_proxy_mode: haproxy
k8s_api_domain: api.example.com
k8s_endpoint_port: 6443
k8s_api_endpoint: "{{ k8s_api_domain if k8s_proxy_mode_enable else hostvars[groups['k8s_master'][0]]['k8s_ip4'].split('/')[0] }}:{{ k8s_endpoint_port }}"
k8s_cluster_name: dustbox.kr
k8s_interface: eth1
k8s_network: calico
k8s_cluster_svc_ip: 10.96.0.0/12
k8s_pod_cidr: 10.88.0.0/16
k8s_svc_node_port_range: 30000-32767
k8s_cluster_domain: cluster.local
k8s_vip_address: 10.10.10.250
k8s_instmethod: config
k8s_bootstrap_token_ttl: 30m
k8s_audit_enabled: true
k8s_selinux_state: enforcing
# Firewall policies must be designed for the chosen CNI; never disable silently.
use_firewalld: false
manage_os_network: false
update_all_packages: false
enabled_virtual: false
ocm_hub: false
ocm_spoke: false
ntp_server1: 3.kr.pool.ntp.org
ntp_server2: 0.asia.pool.ntp.org
time_zone: Asia/Seoul
# Calico 3.33+ separates v3 CRDs from the operator manifest.
calico_manifests:
  - file: v3_projectcalico_org.yaml
    sha256: 5306c2c6d9fd6762d804f9da51c049b8269c33498a364c5df0eed555aba026bd
  - file: tigera-operator.yaml
    sha256: aef423b36aef8cf86567f92bbe5eea4b4ca105a6fc7dbf43de599c6fa70388ba
