#!/usr/bin/env python3
"""Compatibility entry point for independently versioned KAM source."""
from pathlib import Path
import sys
_root = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(_root / 'scripts'))
from kam_source import source_path
__file__ = str(source_path() / 'deploy' / 'legacy-kubectl-kam')
exec(compile(Path(__file__).read_bytes(), __file__, 'exec'), globals())
