global_defs {
    router_id {{ nodename }}
    enable_script_security
    script_user root
}

vrrp_script check_api {
    script "/etc/keepalived/check-kube-apiserver.sh"
    interval 3
    fall 3
    rise 2
    weight -50
}

vrrp_instance VI_1 {
    state {{ keepalived_node | upper }}
    interface {{ k8s_interface }}
    virtual_router_id 51
    priority {{ keepalived_pri }}
    advert_int 1
    virtual_ipaddress {
        {{ k8s_vip_address }}
    }
    track_script {
        check_api
    }
}
