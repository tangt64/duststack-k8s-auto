global
    log /dev/log local0
    daemon
    maxconn 4096

defaults
    mode tcp
    log global
    option tcplog
    timeout connect 5s
    timeout client 1h
    timeout server 1h

frontend kubernetes
    bind *:{{ k8s_endpoint_port }}
    default_backend kubernetes-control-planes

backend kubernetes-control-planes
    balance roundrobin
    option tcp-check
{% for host in groups['k8s_master'] %}
    server control{{ loop.index }} {{ hostvars[host]['k8s_ip4'].split('/')[0] }}:{{ k8s_endpoint_port }} check inter 3s fall 3 rise 2
{% endfor %}
